# =====================================================================
# Review Miner: environment variables (NAMES ONLY, never put real values in this file)
# Set them in Cloudflare Pages → your project → Settings → Variables and Secrets.
# Mark every "SECRET" as Encrypt. VITE_ values are built into the website, so set them
# BEFORE the first build and redeploy after changing them.
# =====================================================================

# ---- Supabase (required) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SECRET: server only
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (required for payments) ----
# SECRET: restricted key with Checkout Sessions: Write, PaymentIntents: Read, Charges: Read, Prices: Read.
# A live key (rk_live_…) takes real payments; a test key (rk_test_…) uses Stripe's test mode.
STRIPE_SECRET_KEY=
# SECRET: signing secret of the webhook endpoint https://YOUR-SITE/api/stripe-webhook (whsec_…).
# Test mode and live mode have different webhook endpoints and secrets.
STRIPE_WEBHOOK_SECRET=
# Test mode only: your test-mode price IDs. Leave all five EMPTY/unset in live mode
# (the live price IDs are built into shared/types.ts).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CORE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_APEX=

# ---- AI (required for searches) ----
# SECRET
ANTHROPIC_API_KEY=
# Optional (default claude-haiku-5-5)
ANTHROPIC_MODEL=
# Optional: web searches per product, default 3, max 10
ANTHROPIC_MAX_SEARCHES=
# SECRET, optional but recommended: Firecrawl reads the product page itself
FIRECRAWL_API_KEY=

# ---- Usage limits (optional) ----
# AI requests per user per hour / per day (defaults 30 / 200)
AI_HOURLY_LIMIT=
AI_DAILY_LIMIT=

# ---- Site (recommended) ----
# Your live address, e.g. https://reviewminer.com (used for Stripe's return pages)
APP_URL=
# Shown on the Privacy Policy and Terms
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=

# ---- Build (recommended) ----
NODE_VERSION=22
